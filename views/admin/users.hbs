{{> header}}
<div style="display:flex; justify-content:space-between; align-items:center">
  <div>
    <h1>Users</h1>
    <div class="sub">All accounts across societies</div>
  </div>
  <a class="btn ghost small" href="/admin/export/users.csv">Export CSV</a>
</div>

<div class="muted" style="font-size:13px; margin:0 2px 12px">
  {{total}} {{#if (eq total 1)}}user{{else}}users{{/if}}{{#if filtered}} matching this filter ·
  <a href="/admin/users">Clear filters</a>{{/if}}
</div>

<div class="card has-filters">
  <table>
    <thead>
      <tr>
        <th>Name {{> colsearch filters.name}}</th>
        <th>Phone {{> colsearch filters.phone}}</th>
        <th>Role {{> colfilter filters.role}}</th>
        <th>Society {{> colpicker filters.society}}</th>
        <th>Status {{> colfilter filters.status}}</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each users}}
      <tr>
        <td>{{this.name}}</td>
        <td>{{this.phone}}</td>
        <td>{{this.role}}</td>
        <td class="muted">{{this.society}}</td>
        <td>{{#if this.banned}}<span class="badge bad">Blocked</span>{{else}}<span class="badge ok">Active</span>{{/if}}</td>
        <td>
          <form method="post" action="/admin/users/{{this.id}}/ban">
            <input type="hidden" name="_csrf" value="{{@root.csrf}}" />
            <input type="hidden" name="back" value="{{@root.pager.selfUrl}}" />
            <button class="btn {{#if this.banned}}ghost{{else}}danger{{/if}} small" type="submit">{{#if this.banned}}Unblock{{else}}Block{{/if}}</button>
          </form>
        </td>
      </tr>
      {{/each}}
      {{#unless users}}<tr><td colspan="6" class="muted">No users match this filter.</td></tr>{{/unless}}
    </tbody>
  </table>
</div>
{{> pager pager}}
{{> footer}}
