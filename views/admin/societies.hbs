{{> header}}
<div style="display:flex; justify-content:space-between; align-items:center">
  <div>
    <h1>Society Management</h1>
    <div class="sub">All societies on the platform</div>
  </div>
  <a class="btn ghost small" href="/admin/export/societies.csv">Export CSV</a>
</div>

<div class="muted" style="font-size:13px; margin:0 2px 12px">
  {{total}} {{#if (eq total 1)}}society{{else}}societies{{/if}}{{#if filtered}} matching this filter ·
  <a href="/admin/societies">Clear filters</a>{{/if}}
</div>

<div class="card has-filters">
  <table>
    <thead>
      <tr>
        <th>Logo</th>
        <th>Society {{> colpicker filters.name}}</th>
        <th>City {{> colpicker filters.city}}</th>
        <th>State {{> colpicker filters.state}}</th>
        <th>Admin name {{> colsearch filters.admin}}</th>
        <th>Contact {{> colsearch filters.contact}}</th>
        <th>Plan {{> colfilter filters.plan}}</th>
        <th>Status {{> colfilter filters.status}}</th>
        <th>Created</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {{#each societies}}
      <tr>
        <td>
          {{#if this.logo}}
            <img src="{{this.logo}}" class="logo-sm" alt="" />
          {{else}}
            <span class="logo-sm logo-fallback">{{this.initial}}</span>
          {{/if}}
        </td>
        <td><a class="rowlink" href="/admin/societies/{{this.id}}">{{this.name}}</a></td>
        <td>{{this.city}}</td>
        <td>{{this.state}}</td>
        <td>{{this.adminName}}</td>
        <td class="muted">{{this.contact}}</td>
        <td><span class="badge {{#if this.isFree}}free{{else}}paid{{/if}}">{{this.plan}}</span></td>
        <td>{{#if this.suspended}}<span class="badge bad">Suspended</span>{{else}}<span class="badge ok">Active</span>{{/if}}</td>
        <td class="muted" style="white-space:nowrap">{{this.created}}</td>
        <td>
          <div class="row-actions">
            {{!-- One link: the society page is both the view and the edit
                  form, so a separate "Edit" only anchored to the same page. --}}
            <a class="btn ghost small" href="/admin/societies/{{this.id}}">Open</a>
            <form method="post" action="/admin/societies/{{this.id}}/suspend">
              <input type="hidden" name="_csrf" value="{{@root.csrf}}" />
              {{#if this.suspended}}
                <button class="btn ghost small" type="submit">Activate</button>
              {{else}}
                <button class="btn ghost small" type="submit">Suspend</button>
              {{/if}}
            </form>
            {{!-- Deletion lives on the society page, where it asks for the
                  name to be typed. One click in a list is too easy. --}}
          </div>
        </td>
      </tr>
      {{/each}}
      {{#unless societies}}<tr><td colspan="10" class="muted">No societies match this filter.</td></tr>{{/unless}}
    </tbody>
  </table>
</div>
{{> pager pager}}
{{> footer}}
