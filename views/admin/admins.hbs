{{> header}}
<h1>Super Admins</h1>
<div class="sub">Who can access this panel</div>

<div class="card" style="padding:18px 20px; margin-bottom:20px">
  <h2 style="margin:0 0 12px">Add super-admin</h2>
  <form method="post" action="/admin/admins" style="display:grid; gap:10px; max-width:420px">
    <input type="text" name="name" placeholder="Name" required />
    <input type="email" name="email" placeholder="email@nestora.app" required />
    <input type="password" name="password" placeholder="Password (min 4 chars)" required />
    <button class="btn primary" type="submit" style="justify-self:start">Add</button>
  </form>
</div>

<div class="card">
  <table>
    <thead><tr><th>Name</th><th>Email</th><th></th></tr></thead>
    <tbody>
      {{#each admins}}
      <tr>
        <td>{{this.name}}</td>
        <td>{{this.email}}</td>
        <td>
          <form method="post" action="/admin/admins/{{this.id}}/delete" onsubmit="return confirm('Remove this super-admin?')">
            <button class="btn danger small" type="submit">Remove</button>
          </form>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{> footer}}
