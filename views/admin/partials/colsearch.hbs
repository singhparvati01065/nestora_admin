{{!-- Same control as [colfilter], but the column is free text: the menu holds
      a search box. The hidden fields carry the other columns' filters, so
      searching here never clears them. --}}
<details class="colfilter{{#if value}} on{{/if}}">
  <summary title="Filter"><svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
      <path d="M2 4.5h12M4 8h8M6.5 11.5h3" stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" fill="none" />
    </svg></summary>
  <div class="colfilter-menu">
    <form method="get" action="{{action}}" class="colfilter-search">
      {{#each hidden}}
        <input type="hidden" name="{{this.name}}" value="{{this.value}}" />
      {{/each}}
      <input type="search" name="{{field}}" value="{{value}}"
             placeholder="{{placeholder}}" />
      <div class="row-actions">
        <button class="btn primary small" type="submit">Apply</button>
        {{#if value}}<a class="btn ghost small" href="{{clearUrl}}">Clear</a>{{/if}}
      </div>
    </form>
  </div>
</details>
