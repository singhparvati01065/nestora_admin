<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nestora Admin</title>
  <link rel="stylesheet" href="/admin-assets/style.css" />
</head>
<body>
  <aside class="sidebar">
    <div class="brand">Nestora <span>Admin</span></div>
    <nav>
      <a href="/admin" class="{{#if (eq page 'dashboard')}}active{{/if}}">Dashboard</a>
      <a href="/admin/societies" class="{{#if (eq page 'societies')}}active{{/if}}">Societies</a>
      {{!-- This page manages panel logins (SUPER_ADMIN), not society admins —
            those live under Users and on each society's page. --}}
      <a href="/admin/admins" class="{{#if (eq page 'admins')}}active{{/if}}">Super Admins</a>
      <a href="/admin/users" class="{{#if (eq page 'users')}}active{{/if}}">Users</a>
      <a href="/admin/subscriptions" class="{{#if (eq page 'subscriptions')}}active{{/if}}">Subscriptions</a>
      <a href="/admin/payments" class="{{#if (eq page 'payments')}}active{{/if}}">Payments</a>
      <a href="/admin/complaints" class="{{#if (eq page 'complaints')}}active{{/if}}">Complaints</a>
      <a href="/admin/tickets" class="{{#if (eq page 'tickets')}}active{{/if}}">Support Tickets</a>
      <a href="/admin/broadcast" class="{{#if (eq page 'broadcast')}}active{{/if}}">Announcements</a>
      <a href="/admin/notifications" class="{{#if (eq page 'notifications')}}active{{/if}}">Notification Center</a>
      <a href="/admin/flags" class="{{#if (eq page 'flags')}}active{{/if}}">Feature Flags</a>
      <a href="/admin/reports" class="{{#if (eq page 'reports')}}active{{/if}}">Reports</a>
      <a href="/admin/audit" class="{{#if (eq page 'audit')}}active{{/if}}">Audit Logs</a>
      <a href="/admin/content" class="{{#if (eq page 'content')}}active{{/if}}">CMS</a>
      <a href="/admin/app-version" class="{{#if (eq page 'appversion')}}active{{/if}}">App Version</a>
      <a href="/admin/settings" class="{{#if (eq page 'settings')}}active{{/if}}">Settings</a>
    </nav>
    {{!-- A POST, not a link: a plain GET could be triggered by any page that
          embeds it, and signing someone out should be deliberate. --}}
    <form method="post" action="/admin/logout" class="logout-form"
          onsubmit="return confirm('Log out of the admin panel?')">
      <input type="hidden" name="_csrf" value="{{@root.csrf}}" />
      <button class="logout" type="submit">Log out</button>
    </form>
  </aside>
  <main class="content">
