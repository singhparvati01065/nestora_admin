{{!-- A column filter that is both a search box and a list: type to narrow the
      list (matches highlight as you type — see footer.hbs), or click a value to
      filter by it.

      With [field] set the box is also a real search: Enter submits it as free
      text, so a partial address still works. Without one, the box only sifts
      the list — used where the filter is an id rather than the text shown. --}}
<details class="colfilter{{#if active}} on{{/if}}">
  <summary title="Filter"><svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
      <path d="M2 4.5h12M4 8h8M6.5 11.5h3" stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" fill="none" />
    </svg></summary>
  <div class="colfilter-menu colfilter-picker">
    {{#if field}}
      <form method="get" action="{{action}}" class="colfilter-search">
        {{#each hidden}}
          <input type="hidden" name="{{this.name}}" value="{{this.value}}" />
        {{/each}}
        <input type="search" name="{{field}}" value="{{value}}" autocomplete="off"
               placeholder="{{placeholder}}" />
      </form>
    {{else}}
      <div class="colfilter-search">
        <input type="search" autocomplete="off" placeholder="{{placeholder}}" />
      </div>
    {{/if}}
    <div class="colfilter-options">
      {{#each options}}
        <a href="{{this.url}}" data-label="{{this.label}}"
           class="{{#if this.selected}}selected{{/if}}">{{this.label}}</a>
      {{/each}}
      <div class="colfilter-empty muted" hidden>No match</div>
    </div>
  </div>
</details>
