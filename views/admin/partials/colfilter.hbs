{{!-- A column header filter menu. <details> gives the open/close behaviour
      with no JavaScript; the options are plain links that keep whatever other
      filters are already applied. --}}
<details class="colfilter{{#if active}} on{{/if}}">
  <summary title="Filter"><svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
      <path d="M2 4.5h12M4 8h8M6.5 11.5h3" stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" fill="none" />
    </svg></summary>
  <div class="colfilter-menu">
    {{#each options}}
      <a href="{{this.url}}" class="{{#if this.selected}}selected{{/if}}">{{this.label}}</a>
    {{/each}}
  </div>
</details>
