{{> header}}
<h1>Complaints</h1>
<div class="sub">Across all societies</div>

<div class="row-actions" style="margin-bottom:16px">
  <a class="btn {{#if (eq status '')}}primary{{else}}ghost{{/if}} small" href="/admin/complaints">All</a>
  <a class="btn {{#if (eq status 'OPEN')}}primary{{else}}ghost{{/if}} small" href="/admin/complaints?status=OPEN">Open</a>
  <a class="btn {{#if (eq status 'IN_PROGRESS')}}primary{{else}}ghost{{/if}} small" href="/admin/complaints?status=IN_PROGRESS">In progress</a>
  <a class="btn {{#if (eq status 'RESOLVED')}}primary{{else}}ghost{{/if}} small" href="/admin/complaints?status=RESOLVED">Resolved</a>
</div>

<div class="card">
  <table>
    <thead><tr><th>Title</th><th>Category</th><th>Society</th><th>Flat</th><th>Status</th><th>Assigned to</th><th>Date</th></tr></thead>
    <tbody>
      {{#each complaints}}
      <tr>
        <td>{{this.title}}</td>
        <td>{{this.category}}</td>
        <td class="muted">{{this.society}}</td>
        <td>{{this.flat}}</td>
        <td>
          {{!-- Picking a status only marks the choice; Save writes it. It used
                to submit on change, so a mis-click resolved a complaint with
                no way back through the UI. --}}
          <form method="post" action="/admin/complaints/{{this.id}}/status"
                data-confirm-change style="display:flex; gap:6px; align-items:center">
            <input type="hidden" name="_csrf" value="{{@root.csrf}}" />
            <input type="hidden" name="back" value="{{@root.pager.selfUrl}}" />
            <select name="status" data-initial="{{this.status}}">
              <option value="OPEN" {{#if this.isOpen}}selected{{/if}}>Open</option>
              <option value="IN_PROGRESS" {{#if this.isInProgress}}selected{{/if}}>In progress</option>
              <option value="RESOLVED" {{#if this.isResolved}}selected{{/if}}>Resolved</option>
            </select>
            <button class="btn ghost small" type="submit" disabled>Save</button>
          </form>
        </td>
        <td>
          <form method="post" action="/admin/complaints/{{this.id}}/assign" style="display:flex; gap:6px">
            <input type="hidden" name="_csrf" value="{{@root.csrf}}" />
            <input type="hidden" name="back" value="{{@root.pager.selfUrl}}" />
            <input type="text" name="assignedTo" value="{{this.assignedTo}}"
                   placeholder="Unassigned" style="max-width:160px" />
            <button class="btn ghost small" type="submit">Save</button>
          </form>
        </td>
        <td class="muted">{{this.created}}</td>
      </tr>
      {{/each}}
      {{#unless complaints}}<tr><td colspan="7" class="muted">No complaints.</td></tr>{{/unless}}
    </tbody>
  </table>
</div>
{{> pager pager}}

{{!-- Keeps every "pick then Save" form quiet until its value actually
      changes, so the button never invites a pointless write. --}}
<script>
  document.querySelectorAll('form[data-confirm-change]').forEach(function (form) {
    var field = form.querySelector('select');
    var save = form.querySelector('button[type=submit]');
    if (!field || !save) return;
    var sync = function () {
      save.disabled = field.value === (field.dataset.initial || '');
    };
    field.addEventListener('change', sync);
    sync();
  });
</script>
{{> footer}}
