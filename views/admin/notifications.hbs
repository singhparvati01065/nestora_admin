{{> header}}
<h1>Notification Center</h1>
<div class="sub">Alert a society admin inside the app and on their phone</div>

{{#if sent}}<div class="card" style="padding:14px 18px; margin-bottom:16px; color:#2e7d32">✓ Notification sent.</div>{{/if}}

<div class="broadcast-grid">
<section>
<h2 class="col-head">Compose</h2>
<div class="card" style="padding:22px">
  <form method="post" action="/admin/notifications" style="display:grid; gap:16px">
    <input type="hidden" name="_csrf" value="{{@root.csrf}}" />
    <div>
      <label class="muted" style="font-size:13px">Title</label>
      <input type="text" name="title" placeholder="e.g. New feature available" required style="margin-top:6px" />
    </div>
    <div>
      <label class="muted" style="font-size:13px">Message</label>
      <textarea name="message" rows="4" required
        style="width:100%; padding:10px 12px; border:1px solid var(--line); border-radius:9px; font-size:14px; font-family:inherit; margin-top:6px"></textarea>
    </div>

    <div>
      <label class="muted" style="font-size:13px">Send via</label>
      <div style="display:flex; gap:18px; margin-top:8px; flex-wrap:wrap">
        <label style="display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer">
          <input type="checkbox" name="channels" value="inapp" checked /> In-app
        </label>
        <label style="display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer">
          <input type="checkbox" name="channels" value="push" /> Push
        </label>
        <label style="display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer">
          <input type="checkbox" name="channels" value="email" /> Email <span class="muted">(recorded only)</span>
        </label>
      </div>
      {{!-- Push became real once the API got a service account; email has no
            provider yet, so saying so beats a checkbox that quietly does
            nothing. --}}
      <div class="muted" style="font-size:12px; margin-top:6px">
        In-app shows in the app's bell. Push reaches the phone even when the app
        is closed. Email is logged only — no provider connected yet.
      </div>
    </div>

    <div>
      <label class="muted" style="font-size:13px">Audience</label>
      <div style="display:flex; gap:18px; margin-top:8px; flex-wrap:wrap">
        <label style="display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer">
          <input type="radio" name="audience" value="all_users" checked onchange="toggleList()" /> All societies
        </label>
        <label style="display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer">
          <input type="radio" name="audience" value="all_admins" onchange="toggleList()" /> All society admins
        </label>
        <label style="display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer">
          <input type="radio" name="audience" value="selected" onchange="toggleList()" /> Selected societies
        </label>
      </div>
    </div>

    <div id="societyList" style="display:none; border:1px solid var(--line); border-radius:10px; padding:12px; max-height:220px; overflow:auto">
      {{#each societies}}
      <label style="display:flex; align-items:center; gap:8px; padding:6px 4px; font-size:14px; cursor:pointer">
        <input type="checkbox" name="societyIds" value="{{this.id}}" /> {{this.name}}
      </label>
      {{/each}}
      {{#unless societies}}<div class="muted">No societies yet.</div>{{/unless}}
    </div>

    <button class="btn primary" type="submit" style="justify-self:start">Send notification</button>
  </form>
</div>
</section>

<section>
<h2 class="col-head">
  Sent
  {{#if total}}<span class="muted" style="font-weight:400; font-size:14px">· {{total}} total</span>{{/if}}
</h2>
{{#if history}}
<div class="card" style="padding:0">
  {{#each history}}
  <div class="sent-item">
    <div class="sent-head">
      <div>
        <div class="sent-title">{{this.title}}</div>
        <div class="muted" style="font-size:13px">
          {{this.at}} · {{this.audience}} · {{this.recipients}} societ{{#if (eq this.recipients 1)}}y{{else}}ies{{/if}}
        </div>
      </div>
      <span class="badge free">{{this.channels}}</span>
    </div>
    <div class="sent-body">{{this.message}}</div>
  </div>
  {{/each}}
</div>
{{> pager pager}}
{{else}}
<div class="card muted" style="padding:20px">Nothing sent yet.</div>
{{/if}}
</section>
</div>

<script>
  function toggleList() {
    const sel = document.querySelector('input[name=audience]:checked').value === 'selected';
    document.getElementById('societyList').style.display = sel ? 'block' : 'none';
  }
</script>
{{> footer}}
