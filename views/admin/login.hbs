<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nestora Admin · Login</title>
  <link rel="stylesheet" href="/admin-assets/style.css" />
</head>
<body class="center">
  <div class="login-wrap">
    <div class="brand">Nestora <span>Admin</span></div>
    <p>Super-admin panel</p>
    {{#if error}}<div class="login-err">Wrong email or password.</div>{{/if}}
    <form method="post" action="/admin/login">
      <label>Email</label>
      <input type="email" name="email" placeholder="admin@nestora.app" autofocus />
      <label>Password</label>
      <input type="password" name="password" placeholder="••••••••" />
      <button class="btn primary" type="submit">Log in</button>
    </form>
  </div>
</body>
</html>
