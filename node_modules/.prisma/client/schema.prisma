// Nestora backend — Prisma schema.
// Society management: societies → towers → flats, and the domains built on top
// (residents, notices, bills, complaints, gate visitors/deliveries, amenities).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SOCIETY_ADMIN
  SECURITY_GUARD
  RESIDENT
  MAINTENANCE_STAFF
}

enum ResidentType {
  OWNER
  TENANT
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum VisitorStatus {
  INSIDE
  EXITED
}

enum BillKind {
  RENT // recurring monthly, from a resident's / flat's rent
  MANUAL // recurring monthly maintenance
  OTHER // one-off custom charge; its name is in Bill.title
}

/// Auth identity. Every login is a User with a role. Super admin has no society;
/// residents additionally have a flat; maintenance staff have a staffLabel.
///
/// Two ways in: phone+password (`password` set) or Firebase phone OTP
/// (`firebaseUid` set). Seeded users have only a password; users who first
/// arrive via OTP have only a firebaseUid — hence both are optional.
model User {
  id          String    @id @default(cuid())
  phone       String    @unique
  /// Email login — used by the super-admin web panel. Optional (residents/staff
  /// sign in by phone).
  email       String?   @unique
  password    String?
  firebaseUid String?   @unique
  name        String
  /// Relative URL of the uploaded avatar, e.g. /uploads/ab12.jpg. Null = the
  /// UI falls back to the initial.
  photoUrl    String?
  role        Role
  society     Society?  @relation(fields: [societyId], references: [id])
  societyId   String?
  flat        Flat?     @relation(fields: [flatId], references: [id])
  flatId      String?
  staffLabel  String? // legacy demo label for MAINTENANCE_STAFF
  /// Blocked by the super-admin panel — such an account can't sign in.
  banned      Boolean   @default(false)
  /// Home address — collected for staff (guards / maintenance) the admin adds.
  address     String?
  /// The date a staff member joined, picked by the admin when adding them.
  joinedAt    DateTime?
  /// Optional monthly salary for a staff member (guard / maintenance).
  salary      Decimal?  @db.Decimal(10, 2)
  /// Soft-delete for staff: a removed guard / maintenance account moves to the
  /// admin's staff history (kept for the record) until permanently deleted.
  archivedAt  DateTime?
  /// Complaint categories a maintenance staff handles (Plumbing, Electrical…).
  /// A complaint is offered to every staff whose trades include its category.
  trades      String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum SubscriptionPlan {
  FREE
  PREMIUM_MONTHLY
  PREMIUM_YEARLY
}

model Society {
  id                 String           @id @default(cuid())
  name               String
  address            String
  /// City / state — filled by the super-admin panel (the app collects a single
  /// free-text address).
  city               String?
  state              String?
  /// Relative URL of the uploaded logo. Null = the UI falls back to the
  /// society name's initial.
  logoUrl            String?
  /// False for a society that is one building with no towers: it holds a single
  /// tower row with an empty letter, and its flats are numbered 101, 102 rather
  /// than A101, A102. Fixed at creation — flipping it would renumber every flat.
  hasTowers          Boolean          @default(true)
  /// Recurring monthly maintenance charged to every flat. Once set (via the
  /// admin's Generate), a MANUAL bill for this amount is auto-created each month
  /// from [maintenanceSince] onward — same lazy backfill as rent.
  monthlyMaintenance Decimal?         @db.Decimal(10, 2)
  /// First month the recurring maintenance applies from (anchored to day 1).
  maintenanceSince   DateTime?
  /// Platform subscription, managed by the super-admin panel.
  plan               SubscriptionPlan @default(FREE)
  planExpiresAt      DateTime?
  suspended          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  towers        Tower[]
  flats         Flat[]
  users         User[]
  residents     Resident[]
  notices       Notice[]
  notifications AppNotification[]
  bills         Bill[]
  complaints    Complaint[]
  visitors      Visitor[]
  preApproved   PreApprovedVisitor[]
  deliveries    Delivery[]
  amenities     Amenity[]
  bookings      AmenityBooking[]
  tickets       SupportTicket[]
}

model Tower {
  id        String  @id @default(cuid())
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  name      String // "Tower A"
  letter    String // "A"
  flats     Flat[]

  @@unique([societyId, letter])
}

model Flat {
  id        String  @id @default(cuid())
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  tower     Tower   @relation(fields: [towerId], references: [id], onDelete: Cascade)
  towerId   String
  number    String // "A101"
  floor     Int

  /// Admin-set recurring charges for this flat. Once [billingSince] is set (via
  /// the Bills → Generate form), a RENT and/or MANUAL bill of these amounts is
  /// auto-created each month from that month onward — same lazy backfill as the
  /// per-resident rent. A flat's per-resident rent still wins (dedup by kind).
  rentAmount        Decimal?  @db.Decimal(10, 2)
  maintenanceAmount Decimal?  @db.Decimal(10, 2)
  billingSince      DateTime?

  users       User[]
  residents   Resident[]
  bills       Bill[]
  complaints  Complaint[]
  visitors    Visitor[]
  preApproved PreApprovedVisitor[]
  deliveries  Delivery[]
  bookings    AmenityBooking[]

  @@unique([societyId, number])
}

/// Directory entry managed by the society admin (owner/tenant of a flat).
model Resident {
  id                String       @id @default(cuid())
  society           Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId         String
  flat              Flat         @relation(fields: [flatId], references: [id], onDelete: Cascade)
  flatId            String
  name              String
  phone             String
  type              ResidentType @default(OWNER)
  /// Monthly rent for this tenancy. When set with [moveInDate], a bill is
  /// auto-generated each month on the move-in day-of-month. (Rent is now
  /// usually set via the admin's Generate Bill flow instead — see
  /// Flat.rentAmount — so this stays nullable and is optional at add time.)
  monthlyRent       Decimal?     @db.Decimal(10, 2)
  moveInDate        DateTime?
  /// One-time advance / security deposit collected at move-in.
  advanceAmount     Decimal?     @db.Decimal(10, 2)
  /// Monthly maintenance agreed for this tenancy.
  maintenanceAmount Decimal?     @db.Decimal(10, 2)
  /// What the resident does for a living, e.g. "Software Engineer".
  occupation        String?
  /// How many people live in the flat (including the resident).
  familyMembers     Int?
  /// Uploaded document image URLs (ID proof etc.), like other /uploads URLs.
  documentUrls      String[]     @default([])
  /// When the resident was removed (soft delete). Null = active. Archived
  /// residents move to the history screen; only a permanent delete truly drops
  /// the row.
  archivedAt        DateTime?
  createdAt         DateTime     @default(now())
}

model Notice {
  id        String   @id @default(cuid())
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum TicketStatus {
  OPEN
  PENDING
  CLOSED
}

/// A support ticket a society admin raises; handled in the super-admin panel.
model SupportTicket {
  id        String       @id @default(cuid())
  society   Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  category  String
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  assignee  String?
  createdAt DateTime     @default(now())
}

/// A notification the super-admin sent from the panel's Notification Center.
/// In-app is delivered via AppNotification; push/email are recorded here (real
/// delivery needs an FCM / email provider).
model PlatformNotification {
  id         String   @id @default(cuid())
  title      String
  message    String
  channels   String // comma-separated: push,email,inapp
  audience   String // all_users | all_admins | selected
  recipients Int      @default(0)
  createdAt  DateTime @default(now())
}

/// One row per successful login — powers the panel's login analytics.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  role      String
  createdAt DateTime @default(now())
}

/// App content the super-admin edits without shipping an app update — FAQ,
/// legal pages, About/Contact. Keyed by a fixed slug.
model ContentPage {
  key       String   @id // faq | terms | privacy | about | contact
  title     String
  body      String   @default("")
  updatedAt DateTime @default(now()) @updatedAt
}

/// Single-row platform settings, managed by the super-admin panel. Integration
/// keys are stored here; wiring them to real services is separate.
model PlatformSettings {
  id              String   @id @default("main")
  appName         String   @default("Nestora")
  logoUrl         String?
  defaultLanguage String   @default("en")
  maintenanceMode Boolean  @default(false)
  smtpHost        String?
  smtpUser        String?
  smtpPass        String?
  firebaseKey     String?
  paymentKey      String?
  whatsappKey     String?
  smsKey          String?
  updatedAt       DateTime @default(now()) @updatedAt
}

/// Single-row app version config, managed by the super-admin panel and read by
/// the mobile app on launch to prompt / force updates.
model AppConfig {
  id             String   @id @default("app")
  androidVersion String   @default("1.0.0")
  iosVersion     String   @default("1.0.0")
  forceUpdate    Boolean  @default(false)
  releaseNotes   String   @default("")
  updatedAt      DateTime @default(now()) @updatedAt
}

/// A platform-wide feature toggle, flipped from the super-admin panel.
model FeatureFlag {
  key       String   @id
  label     String
  enabled   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt
}

/// A record of an action the super-admin took in the web panel.
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  detail    String
  actor     String
  createdAt DateTime @default(now())
}

/// An in-app notification for the society admin — e.g. a resident paid a bill.
model AppNotification {
  id        String   @id @default(cuid())
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Bill {
  id        String    @id @default(cuid())
  society   Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  flat      Flat      @relation(fields: [flatId], references: [id], onDelete: Cascade)
  flatId    String
  period    String // "Jul 2026"
  amount    Decimal   @db.Decimal(10, 2)
  paid      Boolean   @default(false)
  kind      BillKind  @default(MANUAL)
  /// Name of an OTHER (custom) charge, e.g. "Parking". Empty for rent/maintenance
  /// — it's part of the uniqueness key so several OTHER charges (different names)
  /// can coexist in one month while rent/maintenance stay one-per-month.
  title     String    @default("")
  /// The day this bill is due — the resident's move-in day for that month.
  /// Null for older/manually-added bills.
  dueDate   DateTime?
  /// When this bill was paid. Bills paid together (in one tap) share the exact
  /// same timestamp, which is how a payment is grouped into one history entry.
  paidAt    DateTime?
  /// Soft delete. A deleted bill is hidden from lists but its row stays so the
  /// recurring backfill's dedup won't just recreate it next read.
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  // One rent + one maintenance per flat per period; OTHER charges are limited
  // only by name, so many different custom charges can share a month.
  @@unique([flatId, period, kind, title])
}

model Complaint {
  id          String          @id @default(cuid())
  society     Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId   String
  flat        Flat            @relation(fields: [flatId], references: [id], onDelete: Cascade)
  flatId      String
  title       String
  description String
  category    String
  status      ComplaintStatus @default(OPEN)
  assignedTo  String? // staff label
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Visitor {
  id        String        @id @default(cuid())
  society   Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  flat      Flat?         @relation(fields: [flatId], references: [id], onDelete: SetNull)
  flatId    String?
  name      String
  phone     String?
  purpose   String
  vehicleNo String?
  status    VisitorStatus @default(INSIDE)
  inAt      DateTime      @default(now())
  outAt     DateTime?
}

model PreApprovedVisitor {
  id         String   @id @default(cuid())
  society    Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId  String
  flat       Flat     @relation(fields: [flatId], references: [id], onDelete: Cascade)
  flatId     String
  name       String
  purpose    String
  validLabel String
  checkedIn  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Delivery {
  id        String   @id @default(cuid())
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  flat      Flat     @relation(fields: [flatId], references: [id], onDelete: Cascade)
  flatId    String
  courier   String
  collected Boolean  @default(false)
  inAt      DateTime @default(now())
}

model Amenity {
  id        String  @id @default(cuid())
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  name      String
  icon      String

  bookings AmenityBooking[]

  @@unique([societyId, name])
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
}

model AmenityBooking {
  id        String        @id @default(cuid())
  society   Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  amenity   Amenity       @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  amenityId String
  flat      Flat          @relation(fields: [flatId], references: [id], onDelete: Cascade)
  flatId    String
  day       String // ISO date "2026-07-25"
  slot      String
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
}
